# 变量必须以 VITE_ 为前缀才能暴露给客户端读取（import.meta.env.*）
# 说明：oiyo-unibest 不再使用 env/ 目录，env 文件放在项目根目录，
# 由 Vite 默认从根目录按 mode 叠加读取（.env -> .env.<mode>）。

# 应用标题
VITE_APP_TITLE = 'oiyo-unibest'

# 默认后台请求地址
# 不同 mode 会叠加读取 .env.development / .env.test / .env.production 覆盖此值。
# 微信小程序如果没有配置下面的专用地址，也会回退使用这个值。
VITE_SERVER_BASEURL = 'https://ukw0y1.laf.run'

# 微信小程序专用后台请求地址，按微信开发者工具 envVersion 区分。不配置时回退使用 VITE_SERVER_BASEURL。
# VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://dev.xxx.com'
# VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://trial.xxx.com'
# VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://prod.xxx.com'

# h5是否需要配置代理
VITE_APP_PROXY_ENABLE = false
# h5 代理前缀，只要不跟后台统一前缀冲突即可
VITE_APP_PROXY_PREFIX = '/fg-api'

# 认证模式，'single' | 'double' ==> 单token | 双token
VITE_AUTH_MODE = 'single'
